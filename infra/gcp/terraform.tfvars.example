project_id           = "YOUR_PROJECT_ID"
github_repository    = "YOUR_GITHUB_USER/ai-investing"
github_repository_id = "123456789"
# Optional: budget notification (not a hard spending cap)
# billing_account = "XXXXXX-XXXXXX-XXXXXX"
monthly_budget_amount = 10
budget_currency = "USD" # Must match the billing account (e.g. KRW with amount 30000)
# Optional extra warning (e.g. 20000 with a 30000 budget). The 100% notification also triggers the app-level budget stop.
budget_warning_amount = 0
# Set true only after the first deploy created the investing-daily-snapshot Cloud Run Job (docs/operations/jobs.md)
snapshot_schedules_enabled = false
# Set true only after the first deploy created the investing-algo-paper Cloud Run Job and a manual run was checked (docs/operations/jobs.md)
algo_schedules_enabled = false
# Set true only after the first deploy created investing-morning-calendar and a manual run was checked (docs/operations/jobs.md)
morning_schedule_enabled = false
# Set true only after the user approved the monthly AI cost (docs/planning/next-phase-design.md section 5)
morning_ai_enabled = false
# REAL ORDERS. Keep false until the order access check passed, the user checked the WTS Open API settings and enabled live on one algorithm (docs/operations/jobs.md)
live_schedules_enabled = false
# App-level budget stop (docs/operations/budget.md): the https origin of the app, exactly the APP_ORIGIN value (no path or trailing slash).
# Needs billing_account above. Empty keeps the Pub/Sub push out.
# service_url = "https://YOUR_APP_ORIGIN"
