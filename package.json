{
  "name": "folio-investing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node --import tsx src/server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm run build && npm test && npm run security:check",
    "security:check": "node scripts/check-secrets.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:ops": "python3 -m unittest discover -s tests -p 'test_*.py'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@anthropic-ai/vertex-sdk": "^0.22.0",
    "@google-cloud/firestore": "^8.7.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "fast-xml-parser": "^5.11.2",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.1.0",
    "lucide-react": "^0.577.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.1",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/cookie-parser": "^1.4.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^6.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "prettier": "^3.9.10",
    "supertest": "^7.1.0",
    "typescript": "^5.7.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
