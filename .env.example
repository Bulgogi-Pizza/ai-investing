# Local development only. Never put real values in this tracked file.
NODE_ENV=development
PORT=8080
APP_ORIGIN=http://127.0.0.1:5173
# Production: Firestore via workload identity, never a committed service-account key.
GOOGLE_CLOUD_PROJECT=
# Optional local-only administrator; set privately in your shell, never commit.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Official Toss OpenAPI OAuth credentials; server only.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
# Server binds this account to ONE local user ID; no client-supplied account header.
TOSS_ACCOUNT_SEQ=
TOSS_OWNER_USER_ID=

# Optional AI. anthropic = Claude Sonnet 5.5 through the Anthropic API (key from Secret Manager,
# ANTHROPIC_API_KEY); vertex-claude and vertex use server-side IAM and need no key.
AI_PROVIDER=
AI_MODEL=
AI_LOCATION=global
# Anthropic API key (server only; production value lives in Secret Manager). Starts with sk-ant-.
ANTHROPIC_API_KEY=
# Server-side refusal fallback (default true). A fallback model is billed at its own rates.
ANTHROPIC_REFUSAL_FALLBACK=

# External data keys (server only; production values live in Secret Manager).
# DART Open API key (domestic financials and disclosures).
DART_API_KEY=
# FRED API key (US economic indicators).
FRED_API_KEY=
# Bank of Korea ECOS API key (domestic economic indicators).
ECOS_API_KEY=
# Telegram bot token from BotFather (notifications).
TELEGRAM_BOT_TOKEN=
# Telegram chat ID of the owner chat that receives notifications.
TELEGRAM_CHAT_ID=
# SEC EDGAR User-Agent with a contact email, for example "Name contact@example.com".
SEC_USER_AGENT=
