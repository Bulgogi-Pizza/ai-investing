# Local development only. Never put real values in this tracked file.
NODE_ENV=development
PORT=8080
APP_ORIGIN=http://127.0.0.1:5173
# Production: Firestore via workload identity, never a committed service-account key.
GOOGLE_CLOUD_PROJECT=
# Optional local-only administrator; set privately in your shell, never commit.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Official Toss OpenAPI OAuth credentials; server only.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
# Server binds this account to ONE local user ID; no client-supplied account header.
TOSS_ACCOUNT_SEQ=
TOSS_OWNER_USER_ID=

# Optional Vertex narrative, server-side IAM authentication; no API key needed.
AI_PROVIDER=
AI_MODEL=
AI_LOCATION=global
